# Copy to .env and fill in. NEVER commit the real .env.

# --- Database ---
POSTGRES_USER=hunar
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hunar
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hunar:change_me@localhost:5432/hunar

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# A leaked JWT_SECRET lets anyone forge an admin token. Use DIFFERENT values
# for the two secrets, and rotate both before any shared deployment.
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- LLM (JD parsing, role extraction, call transcription) ---
GROQ_API_KEY=

# --- Candidate sourcing ---
APIFY_API_KEY=
APIFY_USER_ID=

# --- Contact enrichment ---
# Apollo person endpoints require a PAID plan; a free-tier key returns
# 403 API_INACCESSIBLE and the pipeline degrades to "no contacts found".
apollo_io_key=
# Enrich.so: email finder (10 credits) + validation (1). Phone lookup costs
# 500 credits per person, so it is skipped unless the balance allows.
Enrich_API_KEY=

# --- Voice calling ---
HUNAR_AI_API_KEY=
HUNAR_AGENT_ID=
# Public HTTPS URL Hunar posts async phone-reveal results to. Leave empty in
# local dev (Hunar cannot reach localhost); the poller covers it either way.
APOLLO_WEBHOOK_URL=

# --- Deployment ---
# Comma-separated origins allowed to call this API. MUST include the
# deployed frontend's origin or the browser blocks every request.
CORS_ORIGINS=http://localhost:5173
