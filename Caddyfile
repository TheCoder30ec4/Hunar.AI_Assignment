# Caddy fetches and renews Let's Encrypt certificates automatically, so
# there is no certbot step. DNS for {$DOMAIN} must already resolve to this
# instance and ports 80/443 must be open before the first start.

{$DOMAIN} {
	encode gzip

	# The API. Everything under /api is stripped and forwarded, so the
	# frontend's default VITE_API_BASE_URL=/api works unchanged.
	handle_path /api/* {
		reverse_proxy api:8000 {
			# Server-Sent Events: the JD parse, search run and bulk-calling
			# endpoints hold a connection open while streaming progress.
			# flush_interval -1 disables response buffering — without it
			# Caddy holds events until the stream closes and the UI sits
			# frozen, then everything arrives at once.
			flush_interval -1

			# A calling run polls for up to 30 minutes
			# (POLL_TIMEOUT_SECONDS in Backend/core/calling_config.py), so
			# the read timeout has to outlast it or the browser sees the
			# stream drop mid-campaign.
			transport http {
				read_timeout 35m
				write_timeout 35m
			}
		}
	}

	# The built frontend (Frontend/dist), if served from this same box.
	# SPA fallback: unknown paths return index.html so client-side routes
	# like /campaigns/<id> survive a hard refresh.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	header {
		# HSTS. Remove if you might ever need plain HTTP on this domain.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
