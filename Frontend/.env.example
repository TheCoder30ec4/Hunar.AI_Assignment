# Copy to .env and fill in. NEVER commit the real .env.

# Where the frontend sends API calls. Defaults to "/api", which assumes a
# reverse proxy in front of both the app and the backend.
#
# In dev this is intercepted by MSW, which forwards to http://localhost:8000.
# MSW is EXCLUDED from production builds, so in production /api must be
# routed to the FastAPI server by nginx/Caddy/your platform — otherwise every
# request 404s against the static-file host. Alternatively set this to the
# backend's absolute URL and enable CORS for the app's origin.
VITE_API_BASE_URL=/api
