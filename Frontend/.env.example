# Copy to .env and fill in. NEVER commit the real .env.

# Where the frontend sends API calls.
#
# LOCAL DEV — leave as /api. MSW intercepts these and forwards them to
# http://localhost:8000 (see src/mocks/handlers.ts).
#
# PRODUCTION — set this to the backend's absolute URL, with NO trailing
# path. MSW is excluded from production builds, so nothing would proxy /api
# on the static host and every request would 404.
#
#   VITE_API_BASE_URL=https://hunar-api.onrender.com
#
# Not ".../api": the backend mounts its routers at /auth, /campaigns and
# /searches with no /api prefix, so adding one produces 404s.
#
# The backend must also allow this app's origin — set CORS_ORIGINS there to
# the deployed frontend URL, or the browser blocks every request while curl
# keeps working.
VITE_API_BASE_URL=/api

# Set to 1 to mount the Agentation click-to-annotate toolbar in dev. Off by
# default: its overlay intercepts pointer events across the whole viewport,
# which blocks normal clicking and breaks e2e tests.
VITE_AGENTATION=
