{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness — see .claude/PLAN.md §1.1.
       verbatimModuleSyntax: every type-only import needs `import type`.
       exactOptionalPropertyTypes: `{foo?: T}` rejects `{foo: undefined}`;
       declare optional props that may be explicitly undefined as `?: T | undefined`. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path alias. No baseUrl — deprecated in TS 6, and paths resolves
       relative to this config file without it. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
